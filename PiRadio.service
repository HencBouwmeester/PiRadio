[Unit]
Description=PiRadio Interface service
Wants=mpd.service
After=network.target mpd.service

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/PiRadio
WorkingDirectory=/home/pi
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=%n
